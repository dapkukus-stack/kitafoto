{
  "expo": {
    "name": "KitaFoto",
    "slug": "kitafoto",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icons/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/images/icons/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E3F2FD"
    },
    "android": {
      "package": "com.kitafoto.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/app-icon.png",
        "backgroundColor": "#4FC3F7"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "minSdkVersion": 26,
      "targetSdkVersion": 34
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "KitaFoto membutuhkan akses kamera untuk mengambil foto photobooth."
        }
      ],
      "expo-av",
      "expo-file-system",
      [
        "expo-media-library",
        {
          "photosPermission": "KitaFoto membutuhkan akses galeri untuk menyimpan foto cadangan.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E3F2FD",
          "image": "./assets/images/icons/app-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "KitaFoto membutuhkan akses kamera untuk photobooth.",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
