{
  "name": "kitafoto",
  "version": "1.0.0",
  "main": "index.js",

  "scripts": {
    "start":            "expo start",
    "android":          "expo run:android",

    "build:android":    "eas build --platform android --profile production",
    "build:apk":        "eas build --platform android --profile apk",
    "build:preview":    "eas build --platform android --profile preview",
    "build:dev":        "eas build --platform android --profile development",
    "build:local":      "npx expo prebuild --platform android && cd android && ./gradlew assembleRelease",

    "type-check":       "tsc --noEmit",
    "lint":             "eslint babel.config.js eslint.config.js",
    "lint:fix":         "eslint babel.config.js eslint.config.js --fix",
    "check":            "npm run type-check && npm run lint",

    "prebuild":         "expo prebuild --platform android --clean",
    "clean":            "rm -rf node_modules .expo dist android/build ios/build android/app/build",
    "clean:android":    "cd android && ./gradlew clean",
    "postinstall":      "expo doctor || true"
  },

  "dependencies": {
    "expo":                           "~51.0.0",
    "expo-status-bar":                "~1.12.1",
    "expo-splash-screen":             "~0.27.0",
    "expo-file-system":               "~17.0.1",
    "expo-sqlite":                    "~14.0.3",
    "expo-av":                        "~14.0.4",
    "expo-image-manipulator":         "~12.0.5",
    "expo-camera":                    "~15.0.14",
    "expo-media-library":             "~16.0.4",
    "expo-network":                   "~6.0.1",
    "expo-device":                    "~6.0.2",
    "react":                          "18.2.0",
    "react-native":                   "0.74.5",
    "react-native-reanimated":        "~3.10.1",
    "react-native-gesture-handler":   "~2.16.1",
    "react-native-screens":           "3.31.1",
    "react-native-safe-area-context": "4.10.5",
    "@react-navigation/native":       "^6.1.18",
    "@react-navigation/stack":        "^6.4.1",
    "@react-navigation/bottom-tabs":  "^6.6.1",
    "zustand":                        "^4.5.4",
    "react-native-mmkv":              "^2.12.2",
    "@shopify/react-native-skia":     "^1.3.9",
    "cloudinary-react-native":        "^0.1.0",
    "react-native-print":             "^0.11.0",
    "lottie-react-native":            "6.7.0",
    "react-native-uuid":              "^2.0.2",
    "dayjs":                          "^1.11.13",
    "@tanstack/react-query":          "^5.56.2",
    "react-native-svg":               "15.2.0",
    "react-native-vision-camera":     "^4.0.0",
    "babel-plugin-module-resolver":   "^5.0.2"
  },

  "devDependencies": {
    "@babel/core":          "^7.24.0",
    "@types/react":         "~18.2.79",
    "typescript":           "~5.3.3",
    "eslint":               "^10.0.0"
  },

  "engines": {
    "node": ">=18.0.0",
    "npm":  ">=9.0.0"
  },

  "private": true
}
